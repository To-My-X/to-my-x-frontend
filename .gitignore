# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# app build artifacts
*.apk
*.aab
*.ipa

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# environment values (commit only a placeholder template)
.env
.env.*
!.env.example

# local IDE settings
.idea/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# shared agent instructions (override global Git ignore rules)
!/AGENTS.md
!/CLAUDE.md

# shared skills only; keep personal Claude settings ignored
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/skills/**
